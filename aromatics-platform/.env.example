# ==============================================================================
# MỘC HƯƠNG SHOP - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- 1. AIVEN POSTGRESQL CLOUD DATABASE ---
SPRING_DATASOURCE_URL=jdbc:postgresql://pg-mochuong-trietleminh7979-se181979.i.aivencloud.com:15995/defaultdb?sslmode=require
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=your_aiven_password_here
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_FLYWAY_ENABLED=false

# --- 2. JWT & INTERNAL MICROSERVICES SECURITY ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
APP_INTERNAL_SECRET=your_internal_secret_key_here

# --- 3. GOOGLE GEMINI AI ASSISTANT ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- 4. INFRASTRUCTURE (REDIS, KAFKA, EUREKA, ZIPKIN) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka/
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://localhost:9411

# --- 5. CLOUDINARY, SMTP MAIL & VNPAY SANDBOX ---
CLOUDINARY_URL=your_cloudinary_url_here
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-return
